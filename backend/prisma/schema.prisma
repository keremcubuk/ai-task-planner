generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Task {
  id              Int       @id @default(autoincrement())
  externalId      String?
  contentHash     String?   // Duplicate detection için: hash(project + title + source)   
  title           String
  description     String?
  source          String    
  project         String?
  severity        String?   
  status          String?   
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  transitionDate  DateTime?
  dueDate         DateTime?
  completedDate   DateTime?
  assignedTo      String?
  openedBy        String?
  bucketName      String?
  componentName   String?   // UI component name from Checklist Items
  manualPriority  Int?
  aiPriority      Int?
  aiScore         Float?
  position        Int       @default(0)
}

model ConfluenceCookie {
  id          Int      @id @default(autoincrement())
  domain      String   @unique
  cookies     String   // JSON string of cookies
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectReviewScore {
  id              Int       @id @default(autoincrement())
  projectName     String    // Confluence sayfa başlığından
  projectId       String?   // DB'deki Task.project ile eşleşme
  overallScore    Int       // 0-100
  previousScore   Int?      // Önceki dönem puanı
  status          String    // critical, warning, good
  reportDate      DateTime  // Rapor tarihi
  categories      String    // JSON: kategori bazlı puanlar
  criticalIssues  String?   // JSON: kritik sorunlar
  strengths       String?   // JSON: güçlü yönler
  closedIssues    String?   // JSON: önceki dönemden kapanan sorunlar
  remainingIssues String?   // JSON: kalan sorunlar
  rawMarkdown     String    // Orijinal markdown
  confluenceUrl   String?   // Kaynak URL
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([projectName, reportDate])
}
